# Linux: Link zlib/zstd into zig2 executable
#
# zig-llvm's lld static archives (liblldELF.a etc.) reference zlib (adler32_combine)
# and zstd (ZSTD_createCCtx) symbols, but the installed cmake configs don't declare
# them as transitive dependencies. Add them explicitly for the CMake fallback build.
# Use full paths via $ENV{PREFIX} since zig cc only searches sysroot for -l flags.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -881,4 +881,12 @@ target_link_libraries(zig2
 target_link_libraries(zig2 LINK_PUBLIC zigcpp)

+# Link zlib/zstd — transitive deps of lld static archives from zig-llvm.
+# zig cc doesn't search $PREFIX/lib for -l flags, so use full paths.
+set(_prefix "$ENV{PREFIX}")
+target_link_libraries(zig2 PRIVATE
+  "${_prefix}/lib/libz.so"
+  "${_prefix}/lib/libzstd.so"
+)
+
 if(MSVC)
   target_link_libraries(zig2 LINK_PUBLIC ntdll.lib ws2_32.lib)
