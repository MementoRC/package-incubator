# Fix library linking for conda zig-cc toolchain (windows-gnu target)
#
# Changes:
# - Strip .dll extensions from library names to prevent double-extension (zstd.dll.lib)
# - Do NOT add msvcrt.lib: zig's windows-gnu target links CRT automatically

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -147,6 +147,7 @@
     find_library(ZLIB NAMES libz.a libzlibstatic.a z zlib libz NAMES_PER_DIR)
     list(APPEND LLVM_LIBRARIES "${ZLIB}")
 endif()
+string(REPLACE ".dll" "" LLVM_LIBRARIES "${LLVM_LIBRARIES}")

 if(ZIG_STATIC_ZSTD)
     if (MSVC)
