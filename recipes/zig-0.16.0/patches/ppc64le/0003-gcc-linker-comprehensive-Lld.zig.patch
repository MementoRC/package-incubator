# Purpose: Intercept ppc64le ELF final links in Lld.zig::elfLink and invoke
# GNU ld DIRECTLY (no gcc driver).
# Affects: src/link/Lld.zig
# Upstream: TBD (no issue filed)
# Drop-when: Upstream LLD gains full PowerPC64 ELF relocation support
# (R_PPC64_REL24, TOC/.opd handling, etc.)
# Last-verified: 2026-08-15
#
# Rewrite (2026-08-15): previously this patch built a gcc argv and spawned
# a gcc driver by bare name ("powerpc64le-conda-linux-gnu-gcc"). That only
# ever worked at build time, where a gcc_impl build dependency happened to
# be present; recipe.yaml's declared ppc64le RUN dependency is
# binutils_impl_${{ cross_target_platform_ }} only -- no gcc driver exists
# in the packaged/tested environment, and conda-forge zig recipes carry a
# hard prohibition on adding real gcc/clang compiler packages as
# dependencies (build or run). This rewrite drives
# powerpc64le-conda-linux-gnu-ld DIRECTLY, resolved by name via PATH (never
# a hardcoded absolute path). Everything a gcc driver implicitly supplied
# -- CRT objects, default -L search paths, the -lc/-lgcc equivalent,
# --dynamic-linker -- is now supplied EXPLICITLY by locating it in the
# target sysroot, reusing the crawl building/_cross.sh:13-33 already
# performs for the same purpose at build time, extended to also run when
# comp.libc_installation is null (the test-time / packaged-binary case).
#
# Fix (2026-07-30, preserved from the prior version of this patch): the
# libunwind branch previously emitted a bare -Wl,-lunwind, which requires
# an -L search path the installed/packaged zig binary never receives (the
# build-time-only linker wrapper injecting -L.../zig-llvm/lib is not
# shipped). Confirmed via CI: PR #123,
# linux_ppc64le_cross_target_platform_linux-ppc64le failed with
# "cannot find -lunwind: No such file or directory" at package-test time.
# Fix mirrors the sibling libc++ branch: resolve libunwind.so's absolute
# path (co-located with libc++.so.1/libc++.so in zig-llvm/lib/, confirmed
# via recipe/zig-llvm/building/_cmake_flags.sh:161 and
# _runtimes_build.sh) instead of relying on -L + bare -lunwind.

diff --git a/src/link/Lld.zig b/src/link/Lld.zig
--- a/src/link/Lld.zig
+++ b/src/link/Lld.zig
@@ -800,6 +800,52 @@
     return null;
 }

+/// Fixed-depth CRT object lookup: checks `sysroot/usr/lib` then
+/// `sysroot/usr/lib64` for `basename`.  Mirrors the crt_dir path written
+/// by building/_cross.sh:30 (crt_dir=${ZIG_SYSROOT}/usr/lib) plus its
+/// lib64 sibling used by the -L block in elfLink's ppc64le ld-direct
+/// branch -- both are populated unconditionally by the packaged sysroot,
+/// independent of comp.libc_installation.
+fn findSysrootCrt(arena: Allocator, io: Io, sysroot: []const u8, basename: []const u8) !?[]const u8 {
+    for ([_][]const u8{ "usr/lib", "usr/lib64" }) |sub| {
+        const candidate = try std.fs.path.join(arena, &[_][]const u8{ sysroot, sub, basename });
+        Io.Dir.cwd().access(io, candidate, .{}) catch continue;
+        return candidate;
+    }
+    return null;
+}
+
+/// Best-effort recursive crawl for GCC-runtime CRT objects (crtbeginS.o /
+/// crtendS.o), which live under lib/gcc/<triple>/<gcc-version>/ -- a
+/// SIBLING tree of the sysroot, not inside it.  Ports the shell crawl in
+/// building/_cross.sh:13-17 (find "$gcc_lib_dir" -name crtbeginS.o) into
+/// Zig so it also runs when comp.libc_installation is null (packaged zig
+/// binary).  Returns null (not an error) if this gcc-runtime tree is
+/// absent -- the intended end state once no gcc package is installed at
+/// all -- exactly as the pre-existing libc_installation.gcc_dir fallback
+/// already tolerated: crtbeginS.o/crtendS.o are best-effort
+/// constructor/destructor bracketing objects, not required for a valid
+/// link of the plain C code the ppc64le tests compile.
+fn findGccRuntimeCrt(arena: Allocator, gpa: Allocator, io: Io, sysroot: []const u8, basename: []const u8) !?[]const u8 {
+    const triple_dir = std.fs.path.dirname(sysroot) orelse return null;
+    const prefix = std.fs.path.dirname(triple_dir) orelse return null;
+    const triple = std.fs.path.basename(triple_dir);
+    const gcc_lib_root = try std.fs.path.join(arena, &[_][]const u8{ prefix, "lib", "gcc", triple });
+
+    var dir = Io.Dir.openDirAbsolute(io, gcc_lib_root, .{ .iterate = true }) catch return null;
+    defer dir.close(io);
+    var walker = dir.walk(gpa) catch return null;
+    defer walker.deinit();
+    while (true) {
+        const maybe_entry = walker.next(io) catch return null;
+        const entry = maybe_entry orelse break;
+        if (entry.kind == .file and std.mem.eql(u8, entry.basename, basename)) {
+            return try std.fs.path.join(arena, &[_][]const u8{ gcc_lib_root, entry.path });
+        }
+    }
+    return null;
+}
+
 fn elfLink(lld: *Lld, arena: Allocator) !void {
     const comp = lld.base.comp;
     const gpa = comp.gpa;
@@ -874,6 +920,461 @@
             .{},
         );
     } else {
+        // PowerPC64: LLD lacks full PowerPC64 ELF relocation support
+        // (R_PPC64_REL24, TOC/.opd handling) -- see the 0001 arch-support
+        // patch. The final ELF link for this arch is therefore redirected
+        // to GNU ld DIRECTLY, not through a gcc driver: the only ppc64le
+        // run dependency this recipe declares is
+        // binutils_impl_${{ cross_target_platform_ }} (see recipe.yaml) --
+        // no gcc package ships in the packaged/tested environment, and
+        // conda-forge zig recipes carry a hard prohibition on adding real
+        // gcc/clang compiler packages as dependencies. A prior version of
+        // this patch spawned a gcc driver by bare name; it only ever
+        // worked when a gcc package happened to be present at build time
+        // and always failed the packaged zig binary's own tests, which
+        // run with no gcc anywhere on PATH. Everything a gcc driver
+        // implicitly supplied (CRT objects, default -L search paths, the
+        // -lc/-lgcc equivalent, --dynamic-linker) is now supplied
+        // EXPLICITLY below by locating it in the target sysroot, reusing
+        // the crawl building/_cross.sh:13-33 already does for the same
+        // purpose at build time instead of inventing new machinery.
+        // Only redirect the FINAL link, not sub-compilations (e.g. glibc
+        // stub generation). Sub-compilations set
+        // skip_linker_dependencies=true and produce synthetic .so stubs
+        // that zig's own linker (with our 0001 arch patches) handles
+        // correctly; ld.bfd cannot process these synthetic stubs because
+        // it does not understand zig's version-node encoding. Also skip
+        // for compile-only operations (output_mode == .Obj) such as
+        // `zig cc -c -o test.o test.c` -- these produce object files
+        // without linking, so invoking the linker would fail with
+        // "undefined reference to main" because no link step is needed.
+        // Upstream: TBD (no issue filed).
+        const is_ppc64 = target.cpu.arch == .powerpc64le or target.cpu.arch == .powerpc64;
+        const use_ld_linker = is_ppc64 and !comp.skip_linker_dependencies and output_mode != .Obj;
+
+        if (use_ld_linker) {
+            var argv = std.array_list.Managed([]const u8).init(gpa);
+            defer argv.deinit();
+
+            // Resolve the linker by NAME only (never a hardcoded absolute
+            // path) so std.process.spawn's PATH search locates whatever
+            // binutils_impl_${{ cross_target_platform_ }} installs. A
+            // missing binary surfaces as a clear spawn error below --
+            // no gcc driver is spawned anywhere in this branch.
+            const ld_path: []const u8 = if (target.cpu.arch == .powerpc64le)
+                "powerpc64le-conda-linux-gnu-ld"
+            else
+                "powerpc64-conda-linux-gnu-ld";
+            try argv.append(ld_path);
+
+            try argv.append("-o");
+            try argv.append(full_out_path);
+
+            // Link mode: native `ld` spelling, identical to the unpatched
+            // LLD-invocation branch below -- no gcc-driver translation
+            // needed here.
+            if (link_mode == .static) {
+                try argv.append("-static");
+            } else if (is_dyn_lib) {
+                try argv.append("-shared");
+            }
+
+            if (comp.config.pie and output_mode == .Exe) {
+                try argv.append("-pie");
+            }
+
+            if (comp.sysroot) |sysroot| {
+                try argv.append(try std.fmt.allocPrint(arena, "--sysroot={s}", .{sysroot}));
+            }
+
+            // Entry point (native ld: two argv elements, no -Wl, wrapper)
+            if (elf.entry_name) |name| {
+                try argv.append("--entry");
+                try argv.append(name);
+            }
+
+            if (output_mode == .Exe) {
+                try argv.append("-z");
+                try argv.append(try std.fmt.allocPrint(arena, "stack-size={d}", .{base.stack_size}));
+            }
+
+            switch (elf.hash_style) {
+                .gnu => try argv.append("--hash-style=gnu"),
+                .sysv => try argv.append("--hash-style=sysv"),
+                .both => {}, // this is the default
+            }
+
+            switch (base.build_id) {
+                .none => try argv.append("--build-id=none"),
+                .fast, .uuid, .sha1, .md5 => try argv.append(try std.fmt.allocPrint(arena, "--build-id={s}", .{
+                    @tagName(base.build_id),
+                })),
+                .hexstring => |hs| try argv.append(try std.fmt.allocPrint(arena, "--build-id=0x{x}", .{hs.toSlice()})),
+            }
+
+            // Image base: intentionally omitted, same as before -- zig's
+            // default image_base is x86_64-centric and not aligned to
+            // ppc64le's 64KB pages. Let ld choose the arch default.
+
+            if (base.gc_sections) {
+                try argv.append("--gc-sections");
+            }
+
+            if (comp.link_eh_frame_hdr) {
+                try argv.append("--eh-frame-hdr");
+            }
+
+            if (elf.z_nodelete) {
+                try argv.append("-z");
+                try argv.append("nodelete");
+            }
+            if (elf.z_notext) {
+                try argv.append("-z");
+                try argv.append("notext");
+            }
+            if (elf.z_defs) {
+                try argv.append("-z");
+                try argv.append("defs");
+            }
+            if (elf.z_origin) {
+                try argv.append("-z");
+                try argv.append("origin");
+            }
+            if (elf.z_nocopyreloc) {
+                try argv.append("-z");
+                try argv.append("nocopyreloc");
+            }
+            if (elf.z_now) {
+                try argv.append("-znow");
+            }
+            if (!elf.z_relro) {
+                try argv.append("-znorelro");
+            }
+
+            // Emulation (CRITICAL for PowerPC)
+            if (getLDMOption(target)) |ldm| {
+                try argv.append("-m");
+                try argv.append(ldm);
+            }
+
+            // Dynamic linker. target.dynamic_linker.get() already returns
+            // the correct ppc64le loader ("/lib64/ld64.so.2" for the gnu
+            // ABI -- verified against lib/std/Target.zig); only the -Wl,
+            // wrapper is dropped here versus the gcc-driver version.
+            if (output_mode == .Exe and link_mode == .dynamic) {
+                if (target.dynamic_linker.get()) |dynamic_linker| {
+                    try argv.append("--dynamic-linker");
+                    try argv.append(dynamic_linker);
+                } else {
+                    try argv.append("--no-dynamic-linker");
+                }
+            }
+
+            // --- CRT objects and default library search paths ---
+            // A gcc driver supplies these implicitly (from its own spec
+            // files) even when comp.libc_installation is null -- the
+            // test-time / packaged-binary case, since plain `zig cc`
