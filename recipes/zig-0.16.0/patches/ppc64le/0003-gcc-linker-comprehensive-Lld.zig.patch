+                    .pie = comp.config.pie,
+                })
+            else
+                std.zig.LibCInstallation.CrtBasenames{};
+
+            var crt_lib_dir: ?[]const u8 = null; // feeds the __tls_get_addr fixup below
+            var wrote_crt0 = false;
+
+            if (comp.config.link_libc) {
+                if (comp.libc_installation) |libc_installation| {
+                    // Build-time: zig already resolved these via the libc
+                    // file building/_cross.sh writes.
+                    const csu = try comp.getCrtPaths(arena);
+                    crt_lib_dir = libc_installation.crt_dir;
+                    if (!is_dyn_lib) {
+                        if (csu.crt0) |p| {
+                            try argv.append(try p.toString(arena));
+                            wrote_crt0 = true;
+                        }
+                    }
+                    if (csu.crti) |p| try argv.append(try p.toString(arena));
+                    if (csu.crtbegin) |p| {
