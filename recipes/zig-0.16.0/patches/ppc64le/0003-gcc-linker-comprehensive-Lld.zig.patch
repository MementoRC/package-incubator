+            // implicitly, so it is resolved explicitly here in both the
+            // build-time (libc_installation present) and test-time
+            // (sysroot crawl) cases.
+            const crt_basenames = if (comp.config.link_libc)
+                std.zig.LibCInstallation.CrtBasenames.get(.{
+                    .target = target,
+                    .link_libc = true,
+                    .output_mode = output_mode,
